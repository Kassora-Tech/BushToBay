# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# Resend API key — get one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional: sender address for quote emails. Must be on a domain verified in Resend.
# Defaults to "Bush to Bay Quotes <quotes@bushtobay.co.za>" if unset.
QUOTE_FROM_EMAIL=

# Meta Graph API — powers the Instagram and Facebook feeds on /social.
# Server-side only (read in lib/meta.ts): never prefix these with NEXT_PUBLIC_.
# If any are missing or a call fails, the page shows a friendly fallback for
# that platform instead of posts.
#
# Non-expiring Page access token, valid for both the Facebook Page and the
# Instagram Business account linked to it.
META_PAGE_ACCESS_TOKEN=

# Numeric ID of the Facebook Page.
FACEBOOK_PAGE_ID=

# Numeric ID of the Instagram Business account (not the @handle).
INSTAGRAM_USER_ID=
